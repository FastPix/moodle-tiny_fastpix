{{!
    @template tiny_fastpix/videos

    The list of the author's embeddable FastPix videos. Each row is a button
    carrying data-playbackid; clicking it inserts {fastpix:pb_<id>} at the
    cursor (handled in tiny_fastpix/ui).

    Context variables required for this template:
    * hasvideos - bool, whether the videos array is non-empty.
    * videos - array of { playbackid, title }.
    * issearch - bool, whether this list is the result of a search (changes the
      empty-state message from "no videos" to "no results").

    Example context (json):
    {
        "hasvideos": true,
        "issearch": false,
        "videos": [
            { "playbackid": "abc123", "title": "Welcome video" }
        ]
    }
}}
{{#hasvideos}}
    <ul class="list-group">
        {{#videos}}
            <li class="list-group-item p-0">
                <button type="button"
                        class="btn btn-link text-start w-100 px-3 py-2 text-decoration-none"
                        data-playbackid="{{playbackid}}">
                    {{title}}
                </button>
            </li>
        {{/videos}}
    </ul>
{{/hasvideos}}
{{^hasvideos}}
    <div role="status" class="alert alert-info m-3">
        {{#issearch}}{{#str}} noresults, tiny_fastpix {{/str}}{{/issearch}}
        {{^issearch}}{{#str}} novideos, tiny_fastpix {{/str}}{{/issearch}}
    </div>
{{/hasvideos}}
